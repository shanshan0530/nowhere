# Required for public / remote Streamable HTTP MCP.
# Generate a fresh long random value for each deployment.
NOWHERE_MCP_TOKEN=replace_with_a_long_random_token

# Optional: QWeather API key. Without it, Nowhere falls back to offline/climate estimates.
# NOWHERE_QWEATHER_KEY=

# Docker/Zeabur persistent data directory. The Dockerfile defaults this to /data.
# NOWHERE_HOME=/data

# Never enable this on a public domain. It is only for explicitly private networks.
# NOWHERE_ALLOW_UNAUTHENTICATED_HTTP=false
